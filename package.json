{
  "name": "lovephone-studio",
  "version": "0.1.0",
  "description": "面向个人 DIY 的 AI 角色陪伴小手机",
  "author": "LovePhone Studio",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "web:build": "node server/build-web.mjs",
    "web:build:public": "node server/build-public-web.mjs",
    "cloudbase:deploy": "node server/deploy-cloudbase.mjs",
    "web": "node server/start-local.mjs",
    "web:only": "node server/static-server.mjs",
    "demo": "node demo/server.mjs",
    "web:lan": "node server/start-lan-preview.mjs",
    "services": "node server/start-services.mjs",
    "desktop": "electron .",
    "desktop:experimental": "electron .",
    "desktop:dir": "electron-builder --win --dir",
    "desktop:build": "electron-builder --win nsis",
    "desktop:installer": "electron-builder --win nsis --prepackaged release/win-unpacked"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "gridstack": "^13.0.0",
    "NeteaseCloudMusicApi": "4.32.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "file-type": "21.3.4",
    "js-yaml": "4.3.1",
    "music-metadata": "11.14.0",
    "@electron/get": {
      "undici": "7.29.0"
    },
    "node-gyp": {
      "undici": "6.28.0"
    }
  },
  "build": {
    "appId": "studio.lovephone.desktop",
    "productName": "LovePhone OS",
    "asar": true,
    "compression": "normal",
    "publish": [],
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**/*",
      "desktop/**/*",
      "server/**/*",
      "!server/music-bridge.mjs",
      "!server/ncm-login.ps1",
      "!server/open-ncm-login.ps1",
      "src/**/*",
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE",
      "docs/PRIVACY.md",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ],
      "icon": "assets/app-icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "differentialPackage": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
